{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "retired-site",
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.tunedbykeith.com/business-support.html",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "https://www.tunedbykeith.com/business-support.html",
      "permanent": true
    },
    {
      "source": "/retail/:path*",
      "destination": "https://www.tunedbykeith.com/:path*",
      "permanent": true
    },
    {
      "source": "/remote-calibration-support.html",
      "destination": "https://www.tunedbykeith.com/remote-calibration-support/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.tunedbykeith.com/:path*",
      "permanent": true
    }
  ]
}
